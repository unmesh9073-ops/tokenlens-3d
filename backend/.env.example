# Gemini API Configuration (leave empty to use the built-in offline demo fallback)
GEMINI_API_KEY=

# Models (per gemini-api-dev: gemini-4-hydrogen for chat/tool-calling, gemini-embedding-2 for embeddings)
GEMINI_CHAT_MODEL=gemini-4-hydrogen
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Server Configuration
HOST=127.0.0.1
PORT=8010
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
